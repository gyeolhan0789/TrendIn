# pipeline/spark/.env 로 복사해 값을 채운다. .env 는 Git 에 올리지 않는다 (루트 .gitignore).
# spark-submit 을 부르기 전에 셸에 올린다:
#
#   set -a; . spark/.env; set +a
#
# 여기에는 비밀과 배포마다 달라지는 주소만 둔다. 임계값은 spark/conf/*.yaml 이다 (09 §3).
# 이 이름들만 설정을 덮는다 — 목록은 src/trendin/spark/common/config.py 의 ENV_BINDINGS.

# 프로파일. --profile 인자가 이것보다 우선한다.
SPARK_JOB_PROFILE=local

# --- MinIO ---
MINIO_ENDPOINT=http://127.0.0.1:9000
# datastore/.env 의 MINIO_SPARK_* 와 같은 값. 지금 이 키는 raw-data 를 읽기만 한다.
# curated 버킷에 쓰려면 datastore 쪽 정책이 먼저 늘어야 한다 (아래 README 참고).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RAW_BUCKET=raw-data
MINIO_CURATED_BUCKET=curated

# --- 앱 DB ---
# 포트는 spark/compose.dev.yaml 이 여는 값 (APP_DB_PORT, 기본 55432).
APP_DB_URL=jdbc:postgresql://127.0.0.1:55432/trendin
APP_DB_USER=trendin
# pipeline/.env 의 APP_DB_PASSWORD 와 같은 값.
APP_DB_PASSWORD=
