# pipeline/.env 로 복사해 값을 채운다. .env 는 Git 에 올리지 않는다 (루트 .gitignore).
# 컨테이너 안 파일 소유자. Linux 는 `id -u` 값.
AIRFLOW_UID=1000
# 메타 DB 계정 airflow 의 비밀번호
AIRFLOW_DB_PASSWORD=
# 앱 DB 계정 trendin 의 비밀번호 (빈 볼륨 초기화 때 한 번 적용된다)
APP_DB_PASSWORD=
# api-server ↔ 태스크 인증 비밀. 예: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
# 메타 DB 에 저장하는 Connection 암호화 키. UI Connection 을 쓰지 않으므로 비워도 된다.
AIRFLOW_FERNET_KEY=
# UI 포트 (127.0.0.1 에만 열린다)
AIRFLOW_UI_PORT=8080
# 앱 DB 접속 URI. 비워 두면 컴포즈 안 postgres 의 trendin DB 를 쓴다.
# EC2 배포에서만 채운다: postgres://<user>:<password>@<host>:5432/forever102
AIRFLOW_CONN_APP_DB=

# --- 수집 계층 저장소 접속 (S15P21A102-156) ---
# 저장소 자체는 datastore/compose.yaml 이 띄운다. 여기는 소비 쪽 값만 둔다.
# 주소는 datastore 네트워크 안의 서비스 이름이라 그대로 두면 된다.
TRENDIN_KAFKA_BOOTSTRAP=kafka:9092
TRENDIN_KAFKA_TOPIC_RAW_FILE_READY=raw-file-ready
# 수집 실행 요약. 비어 있으면 요약은 내지 않고 기사 이벤트만 발급한다.
# 토픽 생성은 datastore 쪽 일이다 — datastore/README.md "토픽 설정" 절.
TRENDIN_KAFKA_TOPIC_RUN_SUMMARY=
TRENDIN_MINIO_ENDPOINT=http://minio:9000
TRENDIN_MINIO_BUCKET=raw-data
# 크롤러용 키. datastore/.env 의 MINIO_CRAWLER_* 와 같은 값을 넣는다.
# 이 키는 버킷에 쓰기만 한다. 삭제 권한도, 관리자 권한도 없다.
TRENDIN_MINIO_ACCESS_KEY=
TRENDIN_MINIO_SECRET_KEY=

# --- Spark (S15P21A102-169) ---
# spark/compose.spark.yaml 을 얹을 때만 필요하다. 그 오버레이 없이 pipeline 만 띄우면
# 아래 값은 읽지 않으므로 비워둬도 된다.
# 크롤러 키(위 TRENDIN_MINIO_*)와 다른 계정이다. 크롤러는 쓰기, Spark 는 읽기다.
# datastore/.env 의 MINIO_SPARK_* 와 같은 값을 넣는다.
TRENDIN_MINIO_SPARK_ACCESS_KEY=
TRENDIN_MINIO_SPARK_SECRET_KEY=
# Spark 가 정제 결과를 쓰는 버킷. datastore 쪽에 생성·쓰기 권한이 아직 없다 (spark/README.md).
TRENDIN_MINIO_CURATED_BUCKET=curated
# Spark 의 JDBC 접속. Airflow 의 AIRFLOW_CONN_APP_DB 와 같은 DB 를 가리켜야 한다.
# 비워 두면 컴포즈 안 postgres 의 trendin DB 를 쓴다. 계정 비밀번호는 APP_DB_PASSWORD 를 쓴다.
SPARK_APP_DB_URL=
SPARK_APP_DB_USER=
# 설정 프로파일. 컨테이너에서는 dev.
SPARK_JOB_PROFILE=dev
