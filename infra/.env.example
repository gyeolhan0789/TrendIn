# Set the real passwords only in infra/.env on EC2. Never commit that file.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Host address PostgreSQL is published on. Leave empty for loopback only.
# Set it to this EC2's private IP when the data EC2 pipeline must reach the
# service DB (S15P21A102-244). Never use 0.0.0.0 — that also exposes the public
# interface. The security group must allow 5432 from the data EC2's group only.
POSTGRES_BIND_IP=

# Backend container
BACKEND_IMAGE=s15p21a102/backend:dev
BACKEND_PORT=8080
DEV_POSTGRES_URL=jdbc:postgresql://postgres:5432/forever102
DEV_POSTGRES_USER_NAME=ssafy
# Set true only for the first deployment to an existing schema without Flyway history.
DEV_FLYWAY_BASELINE_ON_MIGRATE=false
DEV_REDIS_HOST=redis
DEV_REDIS_PORT=6379
# HS256 signing key. Set a random value of at least 32 bytes.
DEV_JWT_SECRET=
DEV_CORS_ALLOWED_ORIGINS=
