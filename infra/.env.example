# infra/.env 로 복사해 씁니다. .env 는 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 아래 값은 **한 대의 장비에서 전체 스택을 띄워 보는 용도의 예시**입니다. 그대로 복사하면
# `docker compose up -d` 가 바로 돕니다. 운영에 올릴 때는 비밀값 넷을 반드시 새로 만듭니다
# (POSTGRES_PASSWORD · REDIS_PASSWORD · DEV_JWT_SECRET · GRAFANA_ADMIN_PASSWORD).

# --- 비밀값 (운영에서는 교체) ---
POSTGRES_PASSWORD=local-postgres-password
REDIS_PASSWORD=local-redis-password

# PostgreSQL 을 어느 인터페이스에 열지. 비우면 루프백만 — 한 대에서 다 띄울 때는 비워 둡니다.
# 데이터 EC2 의 파이프라인이 서비스 DB 에 붙어야 할 때만 그 EC2 의 사설 IP 를 넣습니다.
# 0.0.0.0 은 쓰지 않습니다 — 공인 인터페이스까지 열립니다.
POSTGRES_BIND_IP=

# --- 백엔드 ---
BACKEND_IMAGE=s15p21a102/backend:dev
BACKEND_PORT=8080
DEV_POSTGRES_URL=jdbc:postgresql://postgres:5432/forever102
DEV_POSTGRES_USER_NAME=ssafy
# Flyway 이력이 없는 기존 스키마에 처음 배포할 때만 true 로 둡니다.
DEV_FLYWAY_BASELINE_ON_MIGRATE=false
DEV_REDIS_HOST=redis
DEV_REDIS_PORT=6379
# HS256 서명 키. 32바이트 이상. 운영에서는 `openssl rand -hex 32` 결과로 바꿉니다.
DEV_JWT_SECRET=local-development-only-jwt-secret-change-me-32bytes
# 프런트엔드 오리진. 로컬에서 Vite 개발 서버로 띄우면 http://localhost:5173 입니다.
DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 모니터링 (선택) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password
# Airflow StatsD exporter 가 있는 데이터 EC2 의 사설 IP. 없으면 비웁니다.
PIPELINE_METRICS_HOST=

# --- GitLab OAuth (선택) ---
# 비워 두면 소셜 로그인만 동작하지 않고 이메일 로그인은 그대로 됩니다.
# 쓰려면 lab.ssafy.com 의 Edit profile > Applications 에서 scope read_user 로 등록한 뒤
# Application ID 와 Secret 을 넣습니다. redirect URI 는 등록한 값과 글자 하나까지 같아야 하고,
# 프런트 라우트여야 합니다 — nginx 가 /auth · /domains · /keywords · /members · /trends 를
# 백엔드로 넘기므로 그 접두어를 피합니다.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=
