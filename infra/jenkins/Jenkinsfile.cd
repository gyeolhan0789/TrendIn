pipeline {
    agent any

    options {
        gitLabConnection('ssafy-gitlab')
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'DEPLOY_COMMIT', defaultValue: '', description: 'Manual deployment: full 40-character SHA on dev. Leave empty for latest dev.')
    }

    environment {
        COMPOSE_FILE = 'infra/compose.yaml'
        BACKEND_IMAGE_REPOSITORY = 's15p21a102/backend'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    env.MANUAL_DEPLOY = 'false'
                    if (env.gitlabActionType == 'PUSH' && env.gitlabBranch == 'dev') {
                        if (!(env.gitlabAfter ==~ /[0-9a-fA-F]{40}/)) {
                            error('GitLab push payload does not contain a valid commit SHA')
                        }
                        env.BUILD_COMMIT = env.gitlabAfter
                        env.BUILD_BRANCH = 'dev'
                    } else if (!currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()) {
                        def requestedCommit = (params.DEPLOY_COMMIT ?: '').trim()
                        if (requestedCommit && !(requestedCommit ==~ /[0-9a-fA-F]{40}/)) {
                            error('DEPLOY_COMMIT must be a full 40-character commit SHA')
                        }
                        env.MANUAL_DEPLOY = 'true'
                        env.BUILD_COMMIT = requestedCommit ?: 'origin/dev'
                        env.BUILD_BRANCH = 'dev'
                    } else {
                        error('This job accepts only dev push events or user-triggered manual deployments')
                    }

                    def configuredRemote = scm.userRemoteConfigs[0]
                    if (configuredRemote.credentialsId != 'gitlab-repo') {
                        error('CD Job SCM must use the gitlab-repo credential')
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.BUILD_COMMIT]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout'],
                            [$class: 'CloneOption', honorRefspec: true, noTags: false, reference: '', shallow: false]
                        ],
                        userRemoteConfigs: [[
                            credentialsId: configuredRemote.credentialsId,
                            refspec: "+refs/heads/${env.BUILD_BRANCH}:refs/remotes/origin/${env.BUILD_BRANCH}",
                            url: configuredRemote.url
                        ]]
                    ])
                    if (env.MANUAL_DEPLOY == 'true') {
                        env.BUILD_COMMIT = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    }
                }
                sh '''
                    set -eu
                    test "$(git rev-parse HEAD)" = "$BUILD_COMMIT"
                    git merge-base --is-ancestor "$BUILD_COMMIT" refs/remotes/origin/dev || {
                        echo 'Deployment commit must belong to dev.' >&2
                        exit 1
                    }
                '''
                script {
                    env.GIT_COMMIT = env.BUILD_COMMIT
                }
            }
        }

        stage('Check backend changes') {
            steps {
                script {
                    // Manual runs must redeploy even when there is no new backend diff.
                    env.DIFF_BASE = (env.MANUAL_DEPLOY != 'true' && env.gitlabBefore ==~ /[0-9a-fA-F]{40}/) ? env.gitlabBefore : ''
                    env.BACKEND_CHANGED = sh(returnStdout: true, script: '''
                        set -eu
                        if [ -z "${DIFF_BASE:-}" ] || ! git cat-file -e "$DIFF_BASE^{commit}" 2>/dev/null; then
                            printf true
                        else
                            git diff --no-renames --name-only "$DIFF_BASE" "$BUILD_COMMIT" > .backend-changes
                            if grep -Eq '^(backend/|infra/compose[.]yaml$|infra/jenkins/Jenkinsfile[.]cd$)' .backend-changes; then
                                printf true
                            else
                                printf false
                            fi
                        fi
                    ''').trim()
                    echo "Backend changes: ${env.BACKEND_CHANGED}"
                    if (env.BACKEND_CHANGED == 'true') {
                        env.STATUS_STARTED = 'true'
                        updateGitlabCommitStatus name: 'jenkins/backend-cd', state: 'running'
                    }
                }
            }
        }

        stage('Validate deployment') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                sh '''
                    set -eu
                    command -v docker
                    docker compose version
                    test -n "${DEPLOY_ENV_FILE:-}" || {
                        echo 'DEPLOY_ENV_FILE is not configured in Jenkins.' >&2
                        exit 1
                    }
                    test -r "$DEPLOY_ENV_FILE" || {
                        echo "DEPLOY_ENV_FILE is not readable: $DEPLOY_ENV_FILE" >&2
                        exit 1
                    }
                    docker compose --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" config --quiet
                '''
                script {
                    env.RELEASE_IMAGE = "${env.BACKEND_IMAGE_REPOSITORY}:${env.GIT_COMMIT}-${env.BUILD_NUMBER}"
                    env.PREVIOUS_BACKEND_IMAGE = sh(
                        returnStdout: true,
                        script: '''
                            set -eu
                            container_id=$(docker compose --env-file "$DEPLOY_ENV_FILE" \
                                -f "$COMPOSE_FILE" ps --quiet backend)
                            test -n "$container_id" || {
                                echo 'A running backend container is required for rollback.' >&2
                                exit 1
                            }
                            previous_image=$(docker inspect --format '{{.Config.Image}}' "$container_id")
                            docker image inspect "$previous_image" >/dev/null
                            printf '%s' "$previous_image"
                        '''
                    ).trim()
                    echo "Release image: ${env.RELEASE_IMAGE}"
                    echo "Rollback image: ${env.PREVIOUS_BACKEND_IMAGE}"
                }
            }
        }

        stage('Build bootJar') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    sh './gradlew clean bootJar -x test -x asciidoctor --no-daemon --console=plain'
                }
            }
        }

        stage('Docker image build') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                sh 'BACKEND_IMAGE="$RELEASE_IMAGE" docker compose --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" build backend'
            }
        }

        stage('Deploy backend') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                sh '''
                    set -eu

                    wait_for_backend() {
                        label="$1"
                        attempt=1
                        while [ "$attempt" -le 60 ]; do
                            if status=$(curl --silent --show-error --output /dev/null \
                                --write-out '%{http_code}' http://127.0.0.1:8080/); then
                                case "$status" in
                                    2??|3??|4??)
                                        echo "$label responded with HTTP $status"
                                        return 0
                                        ;;
                                    *)
                                        echo "$label returned HTTP $status" >&2
                                        ;;
                                esac
                            fi
                            echo "Waiting for $label HTTP response ($attempt/60)"
                            attempt=$((attempt + 1))
                            sleep 2
                        done
                        return 1
                    }

                    rollback() {
                        exit_code=$?
                        trap - EXIT
                        echo "Deployment failed. Rolling back to $PREVIOUS_BACKEND_IMAGE" >&2
                        BACKEND_IMAGE="$RELEASE_IMAGE" docker compose \
                            --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" \
                            logs --no-color --tail=200 backend || true

                        if BACKEND_IMAGE="$PREVIOUS_BACKEND_IMAGE" docker compose \
                            --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" \
                            up --detach --no-deps --force-recreate backend \
                            && wait_for_backend 'Rollback backend'; then
                            echo "Rollback completed: $PREVIOUS_BACKEND_IMAGE"
                        else
                            echo 'Automatic rollback failed. Manual recovery is required.' >&2
                        fi
                        exit "$exit_code"
                    }

                    trap rollback EXIT
                    BACKEND_IMAGE="$RELEASE_IMAGE" docker compose \
                        --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" \
                        up --detach --no-deps --force-recreate backend

                    wait_for_backend 'New backend' || {
                        echo 'New backend did not return a non-5xx response within 120 seconds.' >&2
                        exit 1
                    }
                    trap - EXIT
                '''
            }
        }
    }

    post {
        success {
            script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/backend-cd', state: 'success' } }
        }
        unstable {
            script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/backend-cd', state: 'failed' } }
        }
        aborted {
            script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/backend-cd', state: 'canceled' } }
        }
        always {
            junit allowEmptyResults: true, testResults: 'backend/build/test-results/test/*.xml'
        }
        failure {
            script {
                if (env.STATUS_STARTED == 'true') {
                    sh '''
                        if [ -n "${DEPLOY_ENV_FILE:-}" ] && [ -r "$DEPLOY_ENV_FILE" ]; then
                            docker compose --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" ps backend || true
                            docker compose --env-file "$DEPLOY_ENV_FILE" -f "$COMPOSE_FILE" \
                                logs --no-color --tail=200 backend || true
                        fi
                    '''
                    updateGitlabCommitStatus name: 'jenkins/backend-cd', state: 'failed'
                }
            }
        }
    }
}
