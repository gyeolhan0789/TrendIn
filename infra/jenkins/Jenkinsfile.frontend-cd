pipeline {
    agent any

    options {
        gitLabConnection('ssafy-gitlab')
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'DEPLOY_COMMIT', defaultValue: '', description: 'Manual deployment: full 40-character SHA on dev. Leave empty for latest dev.')
    }

    environment {
        VITE_API_BASE_URL = '/api'
        FRONTEND_ROOT = '/var/www/trendin'
        FRONTEND_HOST = 'j15a102.p.ssafy.io'
    }

    stages {
        stage('Checkout dev') {
            steps {
                script {
                    env.MANUAL_DEPLOY = 'false'
                    if (env.gitlabActionType == 'PUSH' && env.gitlabBranch == 'dev') {
                        if (!(env.gitlabAfter ==~ /[0-9a-fA-F]{40}/)) {
                            error('GitLab push payload does not contain a valid commit SHA')
                        }
                        env.BUILD_COMMIT = env.gitlabAfter.toLowerCase()
                    } else if (!currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()) {
                        def requestedCommit = (params.DEPLOY_COMMIT ?: '').trim()
                        if (requestedCommit && !(requestedCommit ==~ /[0-9a-fA-F]{40}/)) {
                            error('DEPLOY_COMMIT must be a full 40-character commit SHA')
                        }
                        env.MANUAL_DEPLOY = 'true'
                        env.BUILD_COMMIT = requestedCommit ? requestedCommit.toLowerCase() : 'origin/dev'
                    } else {
                        error('This job accepts only dev push events or user-triggered manual deployments')
                    }
                    def remote = scm.userRemoteConfigs[0]
                    if (remote.credentialsId != 'gitlab-repo') {
                        error('CD Job SCM must use the gitlab-repo credential')
                    }
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.BUILD_COMMIT]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout'],
                            [$class: 'CloneOption', honorRefspec: true, noTags: false, reference: '', shallow: false]
                        ],
                        userRemoteConfigs: [[
                            credentialsId: remote.credentialsId,
                            refspec: '+refs/heads/dev:refs/remotes/origin/dev',
                            url: remote.url
                        ]]
                    ])
                    if (env.BUILD_COMMIT == 'origin/dev') {
                        env.BUILD_COMMIT = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    }
                    sh '''
                        set -eu
                        test "$(git rev-parse HEAD)" = "$BUILD_COMMIT"
                        git merge-base --is-ancestor "$BUILD_COMMIT" refs/remotes/origin/dev || {
                            echo 'Deployment commit must belong to dev.' >&2
                            exit 1
                        }
                    '''
                    env.GIT_COMMIT = env.BUILD_COMMIT
                }
            }
        }

        stage('Check frontend changes') {
            steps {
                script {
                    // Unknown/initial push baselines build conservatively rather than skip a release.
                    // Manual runs redeploy regardless of the previous push diff.
                    env.DIFF_BASE = (env.MANUAL_DEPLOY != 'true' && env.gitlabBefore ==~ /[0-9a-fA-F]{40}/) ? env.gitlabBefore : ''
                    env.FRONTEND_CHANGED = sh(returnStdout: true, script: '''
                        set -eu
                        if [ -z "${DIFF_BASE:-}" ] || ! git cat-file -e "$DIFF_BASE^{commit}" 2>/dev/null; then
                            printf true
                        else
                            git diff --no-renames --name-only "$DIFF_BASE" "$BUILD_COMMIT" > .frontend-changes
                            if grep -Eq '^(frontend/|infra/nginx/|infra/jenkins/Jenkinsfile[.]frontend-cd$)' .frontend-changes; then
                                printf true
                            else
                                printf false
                            fi
                        fi
                    ''').trim()
                    echo "Frontend changes: ${env.FRONTEND_CHANGED}"
                    if (env.FRONTEND_CHANGED == 'true') {
                        env.STATUS_STARTED = 'true'
                        updateGitlabCommitStatus name: 'jenkins/frontend-cd', state: 'running'
                    }
                }
            }
        }

        stage('Validate deployment') {
            when { environment name: 'FRONTEND_CHANGED', value: 'true' }
            steps {
                sh '''
                    set -eu
                    command -v rsync
                    command -v curl
                    test -d "$FRONTEND_ROOT" && test ! -L "$FRONTEND_ROOT"
                    test -r "$FRONTEND_ROOT/index.html"
                    test -w "$FRONTEND_ROOT" && test -w "$FRONTEND_ROOT/index.html"
                    sudo -n /usr/sbin/nginx -t
                    systemctl is-active --quiet nginx
                '''
            }
        }

        stage('Install and production build') {
            when { environment name: 'FRONTEND_CHANGED', value: 'true' }
            steps {
                dir('frontend') {
                    sh '''
                        set +x
                        set -eu
                        export FRONTEND_ENV_FILE="${DEPLOY_ENV_FILE:-/home/ubuntu/S15P21A102/infra/.env}"
                        node --version
                        npm --version
                        node --input-type=module <<'NODE'
import { readFileSync } from 'node:fs';
import { parseEnv } from 'node:util';
import { spawnSync } from 'node:child_process';

let deploymentEnv;
try {
    deploymentEnv = parseEnv(readFileSync(process.env.FRONTEND_ENV_FILE, 'utf8'));
} catch {
    console.error('Cannot read or parse the frontend deployment environment file.');
    process.exit(1);
}
const buildEnv = { ...process.env };
for (const key of [
    'VITE_GITLAB_OAUTH_BASE_URL',
    'VITE_GITLAB_OAUTH_CLIENT_ID',
    'VITE_GITLAB_OAUTH_REDIRECT_URI',
]) {
    if (!deploymentEnv[key]?.trim()) {
        console.error(`Required frontend deployment variable is missing: ${key}`);
        process.exit(1);
    }
    buildEnv[key] = deploymentEnv[key];
}
// Never merge the full file: it also contains backend credentials.
// Explicitly exclude inherited OAuth secrets from the frontend build as well.
delete buildEnv.GITLAB_OAUTH_CLIENT_SECRET;
delete buildEnv.VITE_GITLAB_OAUTH_CLIENT_SECRET;
buildEnv.VITE_API_BASE_URL = '/api';
for (const args of [['ci'], ['run', 'build']]) {
    const result = spawnSync('npm', args, { env: buildEnv, stdio: 'inherit' });
    if (result.error || result.status !== 0) {
        console.error('Frontend dependency installation or production build failed.');
        process.exit(result.status || 1);
    }
}
NODE
                        test -s dist/index.html
                    '''
                }
            }
        }

        stage('Deploy and verify frontend') {
            when { environment name: 'FRONTEND_CHANGED', value: 'true' }
            steps {
                sh '''
                    set -eu
                    test -z "$(find frontend/dist -type l -print -quit)"
                    backup=$(mktemp -d)
                    cp -R "$FRONTEND_ROOT/." "$backup/"

                    rollback() {
                        exit_code=$?
                        trap - EXIT
                        echo 'Frontend deployment failed; restoring previous files.' >&2
                        if rsync -r --chmod=D2775,F664 --exclude=/index.html "$backup/" "$FRONTEND_ROOT/" &&
                           rsync -r --chmod=F664 "$backup/index.html" "$FRONTEND_ROOT/"; then
                            echo 'Previous frontend files restored.'
                        else
                            echo "Rollback failed. Backup: $backup" >&2
                        fi
                        exit "$exit_code"
                    }

                    trap rollback EXIT
                    # Assets first, HTML last. Keep old hashed assets for clients with cached HTML.
                    rsync -r --chmod=D2775,F664 --exclude=/index.html frontend/dist/ "$FRONTEND_ROOT/"
                    rsync -r --chmod=F664 frontend/dist/index.html "$FRONTEND_ROOT/"

                    sudo -n /usr/sbin/nginx -t
                    systemctl is-active --quiet nginx
                    curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
                        --noproxy "$FRONTEND_HOST" --resolve "$FRONTEND_HOST:443:127.0.0.1" \
                        "https://$FRONTEND_HOST/" -o "$backup/served-index.html"
                    cmp frontend/dist/index.html "$backup/served-index.html"
                    curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
                        --noproxy "$FRONTEND_HOST" --resolve "$FRONTEND_HOST:443:127.0.0.1" \
                        -H 'Accept: text/html' "https://$FRONTEND_HOST/trends/1" -o "$backup/served-spa.html"
                    cmp frontend/dist/index.html "$backup/served-spa.html"
                    asset=$(node --input-type=module -e 'import fs from "node:fs"; const html=fs.readFileSync("frontend/dist/index.html", "utf8"); const match=html.match(/src="(\\/assets\\/[^" ]+\\.js)"/); if (!match) process.exit(1); console.log(match[1]);')
                    curl --fail --silent --show-error --connect-timeout 5 --max-time 15 \
                        --noproxy "$FRONTEND_HOST" --resolve "$FRONTEND_HOST:443:127.0.0.1" \
                        "https://$FRONTEND_HOST$asset" -o "$backup/served-asset.js"
                    cmp "frontend/dist$asset" "$backup/served-asset.js"
                    status=$(curl --silent --show-error --connect-timeout 5 --max-time 15 \
                        --noproxy "$FRONTEND_HOST" --resolve "$FRONTEND_HOST:443:127.0.0.1" \
                        -o "$backup/api.json" --write-out '%{http_code} %{content_type}' \
                        "https://$FRONTEND_HOST/api/domains")
                    case "$status" in
                        '200 application/json'*) echo 'Frontend, SPA, assets and backend API verified.' ;;
                        *) echo "Backend API verification failed: $status" >&2; exit 1 ;;
                    esac
                    trap - EXIT
                    # Keep the backup for manual recovery; Jenkins/OS temp retention is operator-managed.
                    echo "Previous frontend backup: $backup"
                '''
            }
        }
    }

    post {
        success { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-cd', state: 'success' } } }
        unstable { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-cd', state: 'failed' } } }
        failure { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-cd', state: 'failed' } } }
        aborted { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-cd', state: 'canceled' } } }
    }
}
