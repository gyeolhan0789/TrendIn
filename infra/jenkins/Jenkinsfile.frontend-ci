pipeline {
    agent any

    options {
        gitLabConnection('ssafy-gitlab')
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        VITE_API_BASE_URL = '/api'
    }

    stages {
        stage('Checkout MR source') {
            steps {
                script {
                    if (env.gitlabActionType != 'MERGE' || env.gitlabTargetBranch != 'dev') {
                        error('This job accepts only merge requests targeting dev')
                    }
                    if (!(env.gitlabMergeRequestLastCommit ==~ /[0-9a-fA-F]{40}/)) {
                        error('GitLab MR payload does not contain a valid commit SHA')
                    }
                    if (!(env.gitlabSourceBranch ==~ /[A-Za-z0-9][A-Za-z0-9._\/-]*/)
                            || env.gitlabSourceBranch.contains('..')) {
                        error('GitLab MR payload contains an invalid source branch')
                    }
                    env.BUILD_COMMIT = env.gitlabMergeRequestLastCommit
                    env.BUILD_BRANCH = env.gitlabSourceBranch
                    def remote = scm.userRemoteConfigs[0]
                    if (remote.credentialsId != 'gitlab-repo') {
                        error('CI Job SCM must use the gitlab-repo credential')
                    }
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: env.BUILD_COMMIT]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout'],
                            [$class: 'CloneOption', honorRefspec: true, noTags: false, reference: '', shallow: false]
                        ],
                        userRemoteConfigs: [[
                            credentialsId: remote.credentialsId,
                            refspec: "+refs/heads/${env.BUILD_BRANCH}:refs/remotes/origin/${env.BUILD_BRANCH} +refs/heads/dev:refs/remotes/origin/dev",
                            url: remote.url
                        ]]
                    ])
                    sh 'test "$(git rev-parse HEAD)" = "$BUILD_COMMIT"'
                    env.GIT_COMMIT = env.BUILD_COMMIT
                    env.STATUS_STARTED = 'true'
                    updateGitlabCommitStatus name: 'jenkins/frontend-ci', state: 'running'
                }
            }
        }

        stage('Check frontend changes') {
            steps {
                script {
                    env.FRONTEND_CHANGED = sh(returnStdout: true, script: '''
                        set -eu
                        base=$(git merge-base origin/dev "$BUILD_COMMIT")
                        git diff --no-renames --name-only "$base" "$BUILD_COMMIT" > .frontend-changes
                        if grep -Eq '^(frontend/|infra/jenkins/Jenkinsfile.frontend-|infra/nginx/)' .frontend-changes; then
                            printf true
                        else
                            printf false
                        fi
                    ''').trim()
                    echo "Frontend changes: ${env.FRONTEND_CHANGED}"
                }
            }
        }

        stage('Install and production build') {
            when { environment name: 'FRONTEND_CHANGED', value: 'true' }
            steps {
                dir('frontend') {
                    sh 'node --version && npm --version && npm ci && npm run build && test -s dist/index.html'
                }
            }
        }
    }

    post {
        success { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-ci', state: 'success' } } }
        unstable { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-ci', state: 'failed' } } }
        failure { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-ci', state: 'failed' } } }
        aborted { script { if (env.STATUS_STARTED == 'true') { updateGitlabCommitStatus name: 'jenkins/frontend-ci', state: 'canceled' } } }
    }
}
