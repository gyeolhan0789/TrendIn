# datastore/.env 로 복사해 값을 채운다. .env 는 Git 에 올리지 않는다 (루트 .gitignore).
# 여기서 만든 계정·주소를 pipeline/.env 와 spark/.env 가 소비한다. 값이 어긋나면 붙지 않는다.

# --- MinIO ---
# 관리자 계정. minio-init 과 운영자만 쓴다. 애플리케이션에는 주지 않는다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# API · 콘솔 포트를 어느 인터페이스에 열지. 기본은 루프백.
# 다른 호스트가 붙어야 하면 0.0.0.0 으로 바꾸고, 보안 그룹은 팀 대역만 허용한다.
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 원문 버킷 (pipeline/docs/data-pipeline-design.md 4장)
MINIO_BUCKET=raw-data
# 정제 결과 버킷 (pipeline/spark/docs/01-architecture.md 3장). Spark 의 ingest 가 쓰고
# extract 가 읽는다. pipeline/.env 의 TRENDIN_MINIO_CURATED_BUCKET 과 값이 같아야 한다 —
# 어긋나면 ingest 가 쓴 버킷을 extract 가 찾지 못한다. 양쪽 기본값이 curated 라 그대로 둬도 맞는다.
# 수명 주기(만료) 규칙은 걸지 않는다. 만료되면 extract 의 입력이 사라진다 (README "보관 정책").
MINIO_CURATED_BUCKET=curated
# raw-data 의 보관 기간 (Jira S15P21A102-157). curated 에는 적용되지 않는다.
# 만료 기준은 경로의 날짜가 아니라 객체 업로드 시각이다.
# raw-data 전체에 규칙 하나다 — 접두어로 가르면 키 규칙이 바뀔 때 규칙이 어긋난다 (S15P21A102-158).
# 수집 이력(`collected_article`)은 지우지 않으므로, 여기서 만료된 원문을 가리키는 행이
# 남는다. 그 행은 `ingest` 가 이미 처리를 마친 것들이다 (README "보관 정책").
MINIO_RAW_EXPIRE_DAYS=90
# 크롤러용 키: 버킷에 쓰기. 삭제 권한은 없다. pipeline/.env 에 같은 값을 넣는다.
MINIO_CRAWLER_ACCESS_KEY=
MINIO_CRAWLER_SECRET_KEY=
# Spark 용 키: raw-data 는 읽기만 하고(쓰기는 거부된다), curated 에는 쓰고 지운다.
# spark/.env 에 같은 값을 넣는다.
MINIO_SPARK_ACCESS_KEY=
MINIO_SPARK_SECRET_KEY=
