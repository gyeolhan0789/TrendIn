# datastore/.env 로 복사해 값을 채운다. .env 는 Git 에 올리지 않는다 (루트 .gitignore).
# 여기서 만든 계정·주소를 pipeline/.env 와 spark/.env 가 소비한다. 값이 어긋나면 붙지 않는다.

# --- Kafka ---
# KRaft 클러스터 식별자. 첫 기동 때 로그 디렉터리에 새겨진다. 나중에 바꾸면 볼륨을 못 읽는다.
# 새 값: docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
# 브로커 밖에서 붙을 때 쓰는 주소. 컨테이너 밖 클라이언트가 실제로 닿는 값이어야 한다.
# 로컬은 127.0.0.1, EC2 는 사설 IP 또는 도메인 (예: j15a102a.p.ssafy.io).
KAFKA_EXTERNAL_HOST=127.0.0.1
# 호스트 포트를 어느 인터페이스에 열지. 기본은 루프백.
# 다른 호스트가 붙어야 하면 0.0.0.0 으로 바꾸고, 보안 그룹은 팀 대역만 허용한다.
KAFKA_EXTERNAL_BIND=127.0.0.1
KAFKA_EXTERNAL_PORT=29092
# 계약 토픽 (pipeline/docs/data-pipeline-design.md 5장)
KAFKA_TOPIC_RAW_FILE_READY=raw-file-ready
KAFKA_TOPIC_PARTITIONS=3
# 로그 보존. 기본 7일.
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_HEAP_OPTS=-Xmx1G -Xms1G

# --- MinIO ---
# 관리자 계정. minio-init 과 운영자만 쓴다. 애플리케이션에는 주지 않는다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# API · 콘솔 포트를 어느 인터페이스에 열지. Kafka 와 같은 기준.
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 원문 버킷 (pipeline/docs/data-pipeline-design.md 4장)
MINIO_BUCKET=raw-data
# 크롤러용 키: 버킷에 쓰기. 삭제 권한은 없다. pipeline/.env 에 같은 값을 넣는다.
MINIO_CRAWLER_ACCESS_KEY=
MINIO_CRAWLER_SECRET_KEY=
# Spark 용 키: 읽기만. 쓰기는 거부된다. spark/.env 에 같은 값을 넣는다.
MINIO_SPARK_ACCESS_KEY=
MINIO_SPARK_SECRET_KEY=
