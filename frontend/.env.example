# 이 파일을 .env.local 로 복사하면 로컬에서 그대로 동작합니다 (.env.local 은 커밋되지 않습니다).
#
#   cp .env.example .env.local
#
# 백엔드 주소. 아래 값은 로컬 기본값입니다.
# 운영 배포는 /api 를 씁니다 (nginx 가 그 접두어를 백엔드로 넘깁니다).
VITE_API_BASE_URL=http://localhost:8080

# GitLab OAuth. 비워 두면 소셜 로그인 버튼만 동작하지 않고, 이메일 로그인은 그대로 됩니다.
# 쓰려면 백엔드에 넣은 것과 같은 애플리케이션의 Application ID 를 넣습니다.
# redirect-uri 는 제공자에 등록한 값·백엔드 GITLAB_OAUTH_REDIRECT_URI 와 글자 하나까지 같아야
# 토큰 교환이 통과합니다. 비워 두면 지금 열린 주소로 /oauth/gitlab/callback 을 짓습니다.
VITE_GITLAB_OAUTH_BASE_URL=https://lab.ssafy.com
VITE_GITLAB_OAUTH_CLIENT_ID=
VITE_GITLAB_OAUTH_REDIRECT_URI=
